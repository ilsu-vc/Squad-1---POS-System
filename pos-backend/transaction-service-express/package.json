{
  "name": "transaction-service",
  "version": "1.0.0",
  "description": "Transaction processing microservice — owns transactions, transaction_items, receipts, and held_transactions",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:pact:provider": "jest --testPathPattern=tests/pact --testEnvironment=node --runInBand"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "amqplib": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "zod": "^4.3.6",
    "@implementsprint/sdk": "^1.1.2"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^13.1.4",
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
