    "chromedriver": "^131.0.5",
    "dotenv": "^17.4.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "selenium-webdriver": "^4.41.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
